# Forge environment (all optional — sane defaults for local dev)
DATABASE_URL=postgresql://$USER@localhost:5432/forge
FORGE_PORT=3000
FORGE_STORAGE_ROOT=./data
# Git-over-SSH transport (0 disables; host key auto-generated on first boot):
FORGE_SSH_PORT=2222
# FORGE_SSH_HOST_KEY=./data/ssh_host_ed25519_key
# Stable encryption key for TOTP secrets at rest (required in production;
# without it secrets are keyed off the per-process hook token and must be
# re-enrolled after restarts):
# FORGE_SECRET=
# Optional accelerators — app runs fine without them:
# ANTHROPIC_API_KEY=
# Real semantic embeddings via ANY OpenAI-compatible endpoint (OpenAI,
# Voyage, self-hosted Ollama/llama.cpp). Without these, search uses the
# deterministic local hashing embedder (256-dim bag-of-words):
# FORGE_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
# FORGE_EMBEDDINGS_MODEL=text-embedding-3-small
# FORGE_EMBEDDINGS_API_KEY=
# FORGE_EMBEDDINGS_DIM=256
#   NOTE: changing DIM on a database with existing embeddings requires a
#   re-index (push to each branch) — old rows keep the old dimension.
# REDIS_URL=redis://localhost:6379
#   With REDIS_URL set, the login brute-force limiter becomes shared across
#   replicas (sliding window in Redis) AND SSE live-log frames fan out via
#   Redis pub/sub — any replica's browser clients receive any replica's
#   job events. Without it both stay per-process.
# External base URL (correct behind proxies; used for fork remotes + clone hints):
# FORGE_EXTERNAL_URL=https://forge.example.com
# Webhook egress policy: public (default) | private-allow | allowlist
# allowlist additionally requires FORGE_WEBHOOK_PRIVATE_CIDRS="10.0.0.0/8,192.168.1.0/24"
# FORGE_WEBHOOK_EGRESS=public
# FORGE_WEBHOOK_PRIVATE_CIDRS=
# Search cost ceiling (candidate rows scanned per query) + anonymous per-minute cap:
# FORGE_SEARCH_MAX_ROWS=2000
# FORGE_SEARCH_ANON_PER_MIN=10
